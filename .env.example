# Required: Telegram bot token issued by @BotFather.
BOT_TOKEN=

# Required for TMDB search: API Read Access Token (Bearer token), not an API key.
TMDB_API=

# SQLite URL. Relative paths are resolved from the process working directory.
DATABASE_URL=sqlite:///bot.db

# Enable verbose application logging: true/false, 1/0, yes/no, or on/off.
DEBUG=false

# TMDB API endpoint. Change only when using a compatible proxy or mock server.
TMDB_URL=https://api.themoviedb.org/3

# Locale requested from TMDB for titles, descriptions, and season metadata.
TMDB_LANG=ru-RU

# Shared in-process protection for outbound TMDB API calls.
TMDB_MAX_CONCURRENCY=5
TMDB_MAX_REQUESTS_PER_SECOND=20
TMDB_QUEUE_TIMEOUT_SECONDS=5
TMDB_RATE_LIMIT_COOLDOWN_SECONDS=2

# Directory for downloaded media files. Relative paths resolve from the working directory.
MEDIA_ROOT=media

# Optional locally; required by compose. Keeps unfinished FSM flows across bot restarts.
REDIS_URL=

# Lifetime of unfinished FSM state and data in Redis (24 hours by default).
FSM_TTL_SECONDS=86400

# Positive integer used by pytest-xdist when tests run through Make targets.
TEST_PROCESSES=2
