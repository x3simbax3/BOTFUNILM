# Required: Telegram bot token issued by @BotFather.
BOT_TOKEN=

# Required for TMDB search: API Read Access Token (Bearer token), not an API key.
TMDB_API=

# SQLite URL. Relative paths are resolved from the process working directory.
DATABASE_URL=sqlite:///bot.db

# Enable application diagnostics. User text and raw updates are never logged.
DEBUG=false

# TMDB API endpoint. HTTPS is mandatory and the host must be explicitly allowed.
TMDB_URL=https://api.themoviedb.org/3

# Comma-separated exact hostnames trusted to receive the TMDB bearer token.
# Add a compatible proxy here only if you operate and trust it.
TMDB_ALLOWED_HOSTS=api.themoviedb.org

# Locale requested from TMDB for titles, descriptions, and season metadata.
TMDB_LANG=ru-RU

# Shared in-process protection for outbound TMDB API calls.
TMDB_MAX_CONCURRENCY=5
TMDB_MAX_REQUESTS_PER_SECOND=20
TMDB_QUEUE_TIMEOUT_SECONDS=5
TMDB_RATE_LIMIT_COOLDOWN_SECONDS=2
TMDB_MAX_RESPONSE_BYTES=5242880

# Exact HTTPS hostnames Telegram may fetch poster images from.
POSTER_ALLOWED_HOSTS=image.tmdb.org

# Legacy directory for posters downloaded by older releases.
MEDIA_ROOT=media

# Wait for a concurrent SQLite writer instead of failing immediately.
SQLITE_BUSY_TIMEOUT_MS=15000

# Optional locally; required by compose. Keeps unfinished FSM flows across bot restarts.
REDIS_URL=

# Lifetime of unfinished FSM state and data in Redis (24 hours by default).
FSM_TTL_SECONDS=86400

# Bound concurrent update tasks and per-user update bursts before handlers run.
UPDATE_TASKS_CONCURRENCY_LIMIT=32
USER_THROTTLE_MAX_UPDATES=5
USER_THROTTLE_PERIOD_SECONDS=1
USER_THROTTLE_MAX_USERS=10000

# Positive integer used by pytest-xdist when tests run through Make targets.
TEST_PROCESSES=2
